# ── Application ──────────────────────────────────────────────
APP_NAME=google-adk-ollama-docqa
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# ── File uploads ─────────────────────────────────────────────
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=50

# ── Ollama local───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=all-minilm
#OLLAMA_CHAT_MODEL=gemini-2.5-flash
#OLLAMA_CHAT_MODEL=qwen3:1.7b

# ── Ollama Cloud───────────────────────────────────────────────────
#OLLAMA_BASE_URL=https://ollama.com
OLLAMA_CHAT_MODEL=gpt-oss:120b-cloud
OLLAMA_API_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBn35rcCjJZge1x36mTsrYjJZcMPnzIuIlj+rntIRuea


OLLAMA_EMBED_BATCH_SIZE=5
OLLAMA_REQUEST_TIMEOUT=300
OLLAMA_MAX_RETRIES=3

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE_CHARS=800
OVERLAP_CHARS=100
# ── Vector Store ─────────────────────────────────────────────
CHROMA_DIR=storage/chroma
CHROMA_COLLECTION_NAME=document_chunks

# ── Retrieval ────────────────────────────────────────────────
TOP_K_INITIAL=12
TOP_K_SUMMARY=30
MIN_SIMILARITY_SCORE=0.25

# ── Google ADK (optional — for adk web / adk run) ───────────
GOOGLE_API_KEY=AIzaSyBF9vFeneiL6wj6TH-2efFN-EjRanFSq0Q
GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ── Anthropic claude / ollama (optional) ─────────────────────────────────────
#ANTHROPIC_AUTH_TOKEN=ollama
#ANTHROPIC_API_KEY=ollama
#ANTHROPIC_BASE_URL=http://localhost:11434



